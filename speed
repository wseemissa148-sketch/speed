-- برمجة شريط الصحة (Health Bar ESP Engine)
---------------------------------------------------------
local HealthGuis = {}

local function RemovePlayerHealthBar(plr)
    if HealthGuis[plr] then
        if HealthGuis[plr].Gui then
            HealthGuis[plr].Gui:Destroy()
        end
        HealthGuis[plr] = nil
    end
end

local function CreateHealthBar(plr)
    if plr == LocalPlayer then return end
    RemovePlayerHealthBar(plr)

    local function ApplyGui(char)
        if not char then return end
        local head = char:WaitForChild("Head", 5)
        local humanoid = char:WaitForChild("Humanoid", 5)
        if not head or not humanoid then return end

        local Billboard = Instance.new("BillboardGui")
        Billboard.Name = "PlayerHealthESP"
        Billboard.Adornee = head
        Billboard.AlwaysOnTop = true
        Billboard.ExtentsOffset = Vector3.new(0, 2.5, 0)
        Billboard.Parent = ScreenGui

        local Frame = Instance.new("Frame")
        Frame.Size = UDim2.new(1, 0, 1, 0)
        Frame.BackgroundTransparency = 1
        Frame.Parent = Billboard

        if CurrentHealthStyle == 1 then -- Modern Bar
            Billboard.Size = UDim2.new(0, 130, 0, 24)
            Frame.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
            Frame.BackgroundTransparency = 0.3
            local corner = Instance.new("UICorner", Frame)
            corner.CornerRadius = UDim.new(0, 6)

            local Fill = Instance.new("Frame")
            Fill.Name = "Fill"
            Fill.Size = UDim2.new(humanoid.Health / humanoid.MaxHealth, 0, 1, 0)
            Fill.BackgroundColor3 = Color3.fromRGB(0, 220, 100)
            Fill.BorderSizePixel = 0
            Fill.Parent = Frame

            local fillCorner = Instance.new("UICorner", Fill)
            fillCorner.CornerRadius = UDim.new(0, 6)

            local Text = Instance.new("TextLabel")
            Text.Name = "Label"
            Text.Size = UDim2.new(1, 0, 1, 0)
            Text.BackgroundTransparency = 1
            Text.Text = plr.DisplayName .. " [" .. math.floor(humanoid.Health) .. "]"
            Text.TextColor3 = Color3.fromRGB(255, 255, 255)
            Text.TextSize = 10
            Text.Font = Enum.Font.GothamBold
            Text.Parent = Frame

        elseif CurrentHealthStyle == 2 then -- Compact Tag
            Billboard.Size = UDim2.new(0, 100, 0, 18)
            Frame.BackgroundColor3 = Color3.fromRGB(30, 35, 45)
            Frame.BackgroundTransparency = 0.1
            local corner = Instance.new("UICorner", Frame)
            corner.CornerRadius = UDim.new(0, 10)

            local Text = Instance.new("TextLabel")
            Text.Name = "Label"
            Text.Size = UDim2.new(1, 0, 1, 0)
            Text.BackgroundTransparency = 1
            Text.Text = "❤️ " .. math.floor((humanoid.Health / humanoid.MaxHealth) * 100) .. "%"
            Text.TextColor3 = Color3.fromRGB(0, 255, 150)
            Text.TextSize = 11
            Text.Font = Enum.Font.GothamBold
            Text.Parent = Frame

        elseif CurrentHealthStyle == 3 then -- Minimal Line
            Billboard.Size = UDim2.new(0, 80, 0, 6)
            Frame.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
            Frame.BackgroundTransparency = 0.2
            local corner = Instance.new("UICorner", Frame)

            local Fill = Instance.new("Frame")
            Fill.Name = "Fill"
            Fill.Size = UDim2.new(humanoid.Health / humanoid.MaxHealth, 0, 1, 0)
            Fill.BackgroundColor3 = Color3.fromRGB(0, 170, 255)
            Fill.BorderSizePixel = 0
            Fill.Parent = Frame
        end

        HealthGuis[plr] = { Gui = Billboard, Humanoid = humanoid, TargetFrame = Frame }
    end

    if plr.Character then ApplyGui(plr.Character) end
    table.insert(Connections, plr.CharacterAdded:Connect(ApplyGui))
end

local function RefreshHealthBars()
    for plr, _ in pairs(HealthGuis) do
        RemovePlayerHealthBar(plr)
    end
    if HealthBarEnabled then
        for _, plr in ipairs(Players:GetPlayers()) do
            CreateHealthBar(plr)
        end
    end
end

-- حلقة تحديث قراءات الصحة وتدفق الحركة
table.insert(Connections, RunService.RenderStepped:Connect(function()
    if HealthBarEnabled then
        for plr, data in pairs(HealthGuis) do
            if data and data.Humanoid and data.Gui and data.TargetFrame then
                local hum = data.Humanoid
                local percent = math.clamp(hum.Health / hum.MaxHealth, 0, 1)

                if CurrentHealthStyle == 1 then
                    local fill = data.TargetFrame:FindFirstChild("Fill")
                    local lbl = data.TargetFrame:FindFirstChild("Label")
                    if fill then fill.Size = UDim2.new(percent, 0, 1, 0) end
                    if lbl then lbl.Text = plr.DisplayName .. " [" .. math.floor(hum.Health) .. "]" end
                elseif CurrentHealthStyle == 2 then
                    local lbl = data.TargetFrame:FindFirstChild("Label")
                    if lbl then lbl.Text = "❤️ " .. math.floor(percent * 100) .. "%" end
                elseif CurrentHealthStyle == 3 then
                    local fill = data.TargetFrame:FindFirstChild("Fill")
                    if fill then fill.Size = UDim2.new(percent, 0, 1, 0) end
                end
            end
        end
    end
end))

table.insert(Connections, Players.PlayerAdded:Connect(function(plr)
    if HealthBarEnabled then CreateHealthBar(plr) end
end))

table.insert(Connections, Players.PlayerRemoving:Connect(RemovePlayerHealthBar))

