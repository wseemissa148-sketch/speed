-- التحقق من المفتاح وتفعيل الواجهة
---------------------------------------------------------
local KeyUnlocked = false

SubmitBtn.MouseButton1Click:Connect(function()
    if KeyInput.Text == CorrectKey then
        KeyUnlocked = true
        KeyFrame:Destroy()
        MainFrame.Visible = true
    else
        StatusLabel.Text = "المفتاح غير صحيح، حاول مرة أخرى!"
        task.wait(2)
        StatusLabel.Text = ""
    end
end)

-- 7. استقبال الإدخالات لتنسيق زر الإخفاء أو إظهار/إخفاء الواجهة
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed or not KeyUnlocked then return end

    if ListeningForKey then
        if input.UserInputType == Enum.UserInputType.Keyboard then
            ToggleKey = input.KeyCode
            KeybindBtn.Text = "زر الإخفاء: [ " .. tostring(ToggleKey.Name) .. " ]"
            KeybindBtn.TextColor3 = Color3.fromRGB(220, 220, 220)
            ListeningForKey = false
        end
    elseif input.UserInputType == Enum.UserInputType.Keyboard and input.KeyCode == ToggleKey then
        MainFrame.Visible = not MainFrame.Visible
    end
end)

-- 8. منطق السحب بالماوس للـ Slider
local Dragging = false
local function UpdateSlider(input)
    local pos = math.clamp((input.Position.X - SliderFrame.AbsolutePosition.X) / SliderFrame.AbsoluteSize.X, 0, 1)
    SliderFill.Size = UDim2.new(pos, 0, 1, 0)
    SpeedMultiplier = math.floor((MinSpeed + (pos * (MaxSpeed - MinSpeed))) * 10) / 10
    SliderLabel.Text = "مستوى السرعة: " .. tostring(SpeedMultiplier) .. "x"
end

SliderFrame.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        Dragging = true
        UpdateSlider(input)
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        Dragging = false
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if Dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        UpdateSlider(input)
    end
end)

-- 9. زر التفعيل
ToggleBtn.MouseButton1Click:Connect(function()
    SpeedEnabled = not SpeedEnabled
    if SpeedEnabled then
        ToggleBtn.Text = "تفعيل السرعة ⚡ [شغال]"
        ToggleBtn.BackgroundColor3 = Color3.fromRGB(0, 180, 100)
    else
        ToggleBtn.Text = "إيقاف السرعة ❌ [معطل]"
        ToggleBtn.BackgroundColor3 = Color3.fromRGB(230, 50, 50)
    end
end)

-- 10. محرك الحركة السلسة (Heartbeat Loop)
RunService.Heartbeat:Connect(function(delta)
    if SpeedEnabled and KeyUnlocked then
        local char = LocalPlayer.Character
        if char then
            local hrp = char:FindFirstChild("HumanoidRootPart")
            local humanoid = char:FindFirstChild("Humanoid")
            
            if hrp and humanoid and humanoid.MoveDirection.Magnitude > 0 then
                hrp.CFrame = hrp.CFrame + (humanoid.MoveDirection * (SpeedMultiplier * 14) * delta)
            end
        end
    end
end)
