    if ListeningForKey then
        if input.UserInputType == Enum.UserInputType.Keyboard then
            ToggleKey = input.KeyCode
            KeybindBtn.Text = "زر إخفاء الـ UI: [ " .. tostring(ToggleKey.Name) .. " ]"
            KeybindBtn.TextColor3 = Color3.fromRGB(220, 220, 220)
            ListeningForKey = false
        end
    elseif input.UserInputType == Enum.UserInputType.Keyboard and input.KeyCode == ToggleKey then
        MainFrame.Visible = not MainFrame.Visible
    end
end))

-- Slider Logic
local Dragging = false
local function UpdateSlider(input)
    local pos = math.clamp((input.Position.X - SliderFrame.AbsolutePosition.X) / SliderFrame.AbsoluteSize.X, 0, 1)
    SliderFill.Size = UDim2.new(pos, 0, 1, 0)
    SpeedMultiplier = math.floor((MinSpeed + (pos * (MaxSpeed - MinSpeed))) * 10) / 10
    SliderLabel.Text = "مستوى السرعة: " .. tostring(SpeedMultiplier) .. "x"
end

table.insert(Connections, SliderFrame.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        Dragging = true
        UpdateSlider(input)
    end
end))

table.insert(Connections, UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        Dragging = false
    end
end))

table.insert(Connections, UserInputService.InputChanged:Connect(function(input)
    if Dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        UpdateSlider(input)
    end
end))

-- Heartbeat Speed Engine
table.insert(Connections, RunService.Heartbeat:Connect(function(delta)
    if SpeedEnabled and KeyUnlocked then
        local char = LocalPlayer.Character
        if char then
            local hrp = char:FindFirstChild("HumanoidRootPart")
            local humanoid = char:FindFirstChild("Humanoid")
            if hrp and humanoid and humanoid.MoveDirection.Magnitude > 0 then
                hrp.CFrame = hrp.CFrame + (humanoid.MoveDirection * (SpeedMultiplier * 14) * delta)
            end
        end
    end
end))

-- دالة التنظيف المباشرة
getgenv().UniversalSpeedHubCleanUp = function()
    for _, conn in ipairs(Connections) do
        if conn then conn:Disconnect() end
    end
    ClearAllHealthBars()
    if ScreenGui then ScreenGui:Destroy() end
end
