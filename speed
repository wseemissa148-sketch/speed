-- محرك شريط الصحة (ESP Engine بدون فليكر)
---------------------------------------------------------
local HealthGuis = {}

local function RemovePlayerHealthBar(plr)
    if HealthGuis[plr] then
        if HealthGuis[plr].Gui then
            HealthGuis[plr].Gui:Destroy()
        end
        HealthGuis[plr] = nil
    end
end

local function ClearAllHealthBars()
    for plr, _ in pairs(HealthGuis) do
        RemovePlayerHealthBar(plr)
    end
    HealthGuis = {}
end

local function CreateHealthBar(plr)
    if plr == LocalPlayer or not HealthBarEnabled then return end
    RemovePlayerHealthBar(plr)

    local function ApplyGui(char)
        if not char or not HealthBarEnabled then return end
        local head = char:WaitForChild("Head", 5)
        local humanoid = char:WaitForChild("Humanoid", 5)
        if not head or not humanoid then return end

        local Billboard = Instance.new("BillboardGui")
        Billboard.Name = "PlayerHealthESP_Instance"
        Billboard.Adornee = head
        Billboard.AlwaysOnTop = true
        Billboard.ExtentsOffset = Vector3.new(0, 2.8, 0)
        Billboard.Parent = ScreenGui

        local Frame = Instance.new("Frame", Billboard)
        Frame.Size = UDim2.new(1, 0, 1, 0)
        Frame.BackgroundTransparency = 1

        if CurrentHealthStyle == 1 then -- Mode 1: Modern Bar
            Billboard.Size = UDim2.new(0, 130, 0, 22)
            Frame.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
            Frame.BackgroundTransparency = 0.3
            Instance.new("UICorner", Frame).CornerRadius = UDim.new(0, 6)

            local Fill = Instance.new("Frame", Frame)
            Fill.Name = "Fill"
            Fill.Size = UDim2.new(humanoid.Health / humanoid.MaxHealth, 0, 1, 0)
            Fill.BackgroundColor3 = Color3.fromRGB(0, 220, 100)
            Fill.BorderSizePixel = 0
            Instance.new("UICorner", Fill).CornerRadius = UDim.new(0, 6)

            local Text = Instance.new("TextLabel", Frame)
            Text.Name = "Label"
            Text.Size = UDim2.new(1, 0, 1, 0)
            Text.BackgroundTransparency = 1
            Text.Text = plr.DisplayName .. " [" .. math.floor(humanoid.Health) .. "]"
            Text.TextColor3 = Color3.fromRGB(255, 255, 255)
            Text.TextSize = 10
            Text.Font = Enum.Font.GothamBold

        elseif CurrentHealthStyle == 2 then -- Mode 2: Compact Tag
            Billboard.Size = UDim2.new(0, 95, 0, 18)
            Frame.BackgroundColor3 = Color3.fromRGB(30, 35, 45)
            Frame.BackgroundTransparency = 0.1
            Instance.new("UICorner", Frame).CornerRadius = UDim.new(0, 10)

            local Text = Instance.new("TextLabel", Frame)
            Text.Name = "Label"
            Text.Size = UDim2.new(1, 0, 1, 0)
            Text.BackgroundTransparency = 1
            Text.Text = "❤️ " .. math.floor((humanoid.Health / humanoid.MaxHealth) * 100) .. "%"
            Text.TextColor3 = Color3.fromRGB(0, 255, 150)
            Text.TextSize = 10
            Text.Font = Enum.Font.GothamBold

        elseif CurrentHealthStyle == 3 then -- Mode 3: Minimal Line
            Billboard.Size = UDim2.new(0, 85, 0, 5)
            Frame.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
            Frame.BackgroundTransparency = 0.2
            Instance.new("UICorner", Frame)

            local Fill = Instance.new("Frame", Frame)
            Fill.Name = "Fill"
            Fill.Size = UDim2.new(humanoid.Health / humanoid.MaxHealth, 0, 1, 0)
            Fill.BackgroundColor3 = Color3.fromRGB(0, 170, 255)
            Fill.BorderSizePixel = 0
            Instance.new("UICorner", Fill)

        elseif CurrentHealthStyle == 4 then -- Mode 4: Cyber Heart
            Billboard.Size = UDim2.new(0, 110, 0, 20)
            Frame.BackgroundColor3 = Color3.fromRGB(15, 15, 20)
            Frame.BackgroundTransparency = 0.2
            Instance.new("UICorner", Frame).CornerRadius = UDim.new(0, 4)

            local Text = Instance.new("TextLabel", Frame)
            Text.Name = "Label"
            Text.Size = UDim2.new(1, 0, 1, 0)
            Text.BackgroundTransparency = 1
            Text.Text = "💚 " .. plr.DisplayName .. " | " .. math.floor(humanoid.Health)
            Text.TextColor3 = Color3.fromRGB(100, 255, 100)
            Text.TextSize = 10
            Text.Font = Enum.Font.GothamBold

        elseif CurrentHealthStyle == 5 then -- Mode 5: Futuristic Outline
            Billboard.Size = UDim2.new(0, 120, 0, 22)
            Frame.BackgroundColor3 = Color3.fromRGB(10, 10, 15)
            Frame.BackgroundTransparency = 0.4

            local Stroke = Instance.new("UIStroke", Frame)
            Stroke.Color = Color3.fromRGB(0, 255, 255)
            Stroke.Thickness = 1.2

            local Fill = Instance.new("Frame", Frame)
            Fill.Name = "Fill"
            Fill.Size = UDim2.new(humanoid.Health / humanoid.MaxHealth, 0, 1, 0)
            Fill.BackgroundColor3 = Color3.fromRGB(255, 0, 100)
            Fill.BorderSizePixel = 0

            local Text = Instance.new("TextLabel", Frame)
            Text.Name = "Label"
            Text.Size = UDim2.new(1, 0, 1, 0)
            Text.BackgroundTransparency = 1
            Text.Text = math.floor((humanoid.Health / humanoid.MaxHealth) * 100) .. " HP"
            Text.TextColor3 = Color3.fromRGB(255, 255, 255)
            Text.TextSize = 10
            Text.Font = Enum.Font.GothamBold
        end

        HealthGuis[plr] = { Gui = Billboard, Humanoid = humanoid, TargetFrame = Frame }
    end

    if plr.Character then ApplyGui(plr.Character) end
    table.insert(Connections, plr.CharacterAdded:Connect(ApplyGui))
end

local function RefreshHealthBars()
    ClearAllHealthBars()
    if HealthBarEnabled then
        for _, plr in ipairs(Players:GetPlayers()) do
            CreateHealthBar(plr)
        end
    end
end

-- حلقة التحديث المباشرة للصحة (بدون فليكر)
table.insert(Connections, RunService.RenderStepped:Connect(function()
    if not HealthBarEnabled then return end

    for plr, data in pairs(HealthGuis) do
        if data and data.Humanoid and data.TargetFrame and data.Gui then
            local hum = data.Humanoid
            if hum and hum.Parent then
                local percent = math.clamp(hum.Health / hum.MaxHealth, 0, 1)

                if CurrentHealthStyle == 1 or CurrentHealthStyle == 3 or CurrentHealthStyle == 5 then
                    local fill = data.TargetFrame:FindFirstChild("Fill")
                    if fill then fill.Size = UDim2.new(percent, 0, 1, 0) end
                end

                local lbl = data.TargetFrame:FindFirstChild("Label")
                if lbl then
                    if CurrentHealthStyle == 1 then
                        lbl.Text = plr.DisplayName .. " [" .. math.floor(hum.Health) .. "]"
                    elseif CurrentHealthStyle == 2 then
                        lbl.Text = "❤️ " .. math.floor(percent * 100) .. "%"
                    elseif CurrentHealthStyle == 4 then
                        local icon = percent > 0.5 and "💚 " or (percent > 0.25 and "💛 " or "💔 ")
                        lbl.Text = icon .. plr.DisplayName .. " | " .. math.floor(hum.Health)
                    elseif CurrentHealthStyle == 5 then
                        lbl.Text = math.floor(percent * 100) .. " HP"
                    end
                end
            end
        end
    end
end))

table.insert(Connections, Players.PlayerAdded:Connect(function(plr)
    if HealthBarEnabled then CreateHealthBar(plr) end
end))

table.insert(Connections, Players.PlayerRemoving:Connect(RemovePlayerHealthBar))

